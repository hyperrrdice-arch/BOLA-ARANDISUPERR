# Football Agent - Environment Variables Template
# Copy this file to .env.local and populate with your actual credentials.
# DO NOT commit .env.local to version control.

# Football Data API (football-data.org) — legacy (importer fixture fdorg)
STATS_API_KEY=your_football_data_api_key_here

# Hasil FINISHED football-data.org API v4 (Item 7) — adapter hasil kedua
# scripts/import-fdorg-results.ts. Free tier: 10 req/menit; adapter
# memakai guard <= 9 req/menit + hormati HTTP 429.
FOOTBALL_DATA_API_TOKEN=your_football_data_org_token_here

# 9Router / LLM Gateway Configuration
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=your_nine_router_api_key_here
NINE_ROUTER_MODEL=ag/gemini-3.8-flash

# Multi-Agent Syndicate Persona Models
# Nilai di bawah adalah placeholder; opsional. Kalau tidak diisi, tiap jalur memakai
# default di lib/llm/models.ts (Bull = gemini high, Neutral = glm-5.3).
MODEL_FETCHER_DISPATCHER=bai/qwen3.8-27b
MODEL_BULL=ag/gemini-3.8-flash-high
MODEL_NEUTRAL=bai/glm-5.3-flash
MODEL_BEAR=bai/deepseek-v4.1-flash
MODEL_JUDGEMENT_1=ag/gemini-3.8-flash-high
MODEL_JUDGEMENT_2=bai/qwen3.8-flash
MODEL_ARBITER=ag/gemini-3.8-flash-high

# Odds & Bookmaker API (1xBet via RapidAPI)
RAPIDAPI_1XBET_HOST=1xbet-api.p.rapidapi.com
RAPIDAPI_1XBET_KEY=your_rapidapi_key_here

# Odds Pra-Laga Primer (API-Football / API-Sports v3) — Item 20
# Free plan: 100 req/hari, 10 req/menit. Adapter memakai guard keras
# <= 9 req/menit dan <= 80 req/hari; jendela capture tetap 09:00 & 18:00 WIB.
APIFOOTBALL_API_KEY=your_api_football_key_here

# Quantitative Prediction Models (Dixon-Coles & Poisson Engine)
BETTING_MODEL_A=bai/qwen3.8-27b
BETTING_MODEL_B=bai/deepseek-v4.1-flash

# Pre-Match Analyst Agent (planner loop, lib/agent/planner.ts)
MODEL_PLANNER=bai/mimo-v2.6-pro
# Hard cap step loop planner (default 8; rantai dependensi serial minimal 5)
PLANNER_MAX_STEPS=8

# Debug & eksperimen (opsional, default mati)
# PIPELINE_DEBUG=1   -> log verbose (cache HIT/MISS, detail stage)
# DISPATCHER_LLM=1   -> aktifkan kembali dispatcher LLM (default: heuristic langsung)

