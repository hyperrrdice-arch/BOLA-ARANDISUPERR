# Football Agent - Environment Variables Template
# Copy this file to .env.local and populate with your actual credentials.
# DO NOT commit .env.local to version control.

# Football Data API (football-data.org)
STATS_API_KEY=your_football_data_api_key_here

# 9Router / LLM Gateway Configuration
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=your_nine_router_api_key_here
NINE_ROUTER_MODEL=ag/gemini-3.8-flash

# Multi-Agent Syndicate Persona Models
MODEL_FETCHER_DISPATCHER=ag/gemini-3.8-flash
MODEL_BULL=bai/glm-5.3-flash
MODEL_NEUTRAL=bai/deepseek-v4.1-flash
MODEL_BEAR=ag/gemini-3.8-flash-medium
MODEL_JUDGEMENT_1=ag/gemini-3.8-flash-high
MODEL_JUDGEMENT_2=bai/qwen3.8-flash
MODEL_ARBITER=ag/gemini-3.8-flash-high

# Odds & Bookmaker API (1xBet via RapidAPI)
RAPIDAPI_1XBET_HOST=1xbet-api.p.rapidapi.com
RAPIDAPI_1XBET_KEY=your_rapidapi_key_here

# Quantitative Prediction Models (Dixon-Coles & Poisson Engine)
BETTING_MODEL_A=ag/gemini-3.8-flash
BETTING_MODEL_B=ag/gemini-3.8-flash-high

# OddsPapi v4 Sports Betting Odds API
ODDSPAPI_API_KEY=your_oddspapi_key_here
ODDSPAPI_BASE_URL=https://api.oddspapi.io/v4

